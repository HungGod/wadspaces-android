<resources>
    <!-- The window behind Compose: the site's dark background. -->
    <style name="Theme.WadSpaces" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/wad_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- The stream: black behind the desktop until it draws. -->
    <style name="Theme.WadSpaces.Stream" parent="Theme.WadSpaces">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
